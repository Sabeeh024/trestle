# Copy to .env (never commit it) and replace every value. Generate secrets with `openssl rand -hex 32`.
POSTGRES_PASSWORD=change-me
# Shared by the API and both Next apps, so the API trusts the client address they report.
INTERNAL_API_KEY=change-me-to-a-long-random-value
# The apps are served at <DOMAIN>, app.<DOMAIN> and admin.<DOMAIN>.
DOMAIN=trestle.localhost
# Password of every account that `seed` creates. Demo data only.
SEED_PASSWORD=trestle-dev-1
# Which image tag to run (CI uses the git SHA).
TAG=local
