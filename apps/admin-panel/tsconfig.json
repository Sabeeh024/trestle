{
  "extends": "@trestle/typescript-config/tsconfig.react.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "security-headers.ts"],
  "exclude": ["node_modules"]
}
