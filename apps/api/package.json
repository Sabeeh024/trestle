{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "start:prod": "node dist/server.js",
    "build": "node scripts/build.mjs",
    "db:embedded": "tsx scripts/embedded-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed-cli.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/seed-cli.ts --reset",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@trestle/api-client": "workspace:*",
    "@trestle/auth": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/react-query": "^5.104.1",
    "@trestle/typescript-config": "workspace:*",
    "@types/node": "^20",
    "axios": "^1.20.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
