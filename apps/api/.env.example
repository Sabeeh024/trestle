# Copy to .env. Every value below is the default, so the file is optional for local development.
DATABASE_URL=postgres://trestle:trestle@localhost:5432/trestle
PORT=4000
# Browser origins allowed to call the API (the admin panel is a SPA on :5173).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
SESSION_TTL_DAYS=30
# Where emailed set-password / reset links point.
WEB_APP_URL=http://localhost:3000
# Local only: let enterprise users "sign in with SSO" without an identity provider. Refused in production.
DEV_SSO=0
# Password for every account created by `pnpm db:seed`.
SEED_PASSWORD=trestle-dev-1
# How many reverse proxies sit in front of the API (0 = none). Rate limiting reads the client address from
# X-Forwarded-For only as far as this says; leave it 0 when the API is reachable directly.
TRUST_PROXY=0
DB_POOL_MAX=10
